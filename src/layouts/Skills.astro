---
import { skills } from "../data/projects";

// Technology logos using Simple Icons slugs
const marqueeItems = [
    { name: "Astro", slug: "astro" },
    { name: "HTML", slug: "html5" },
    { name: "CSS", slug: "css" },
    { name: "PHP", slug: "php" },
    { name: "Laravel", slug: "laravel" },
    { name: "React", slug: "react" },
    { name: "Svelte", slug: "svelte" },
    { name: "Kotlin", slug: "kotlin" },
    { name: "Flutter", slug: "flutter" },
    { name: "Python", slug: "python" },
    { name: "C", slug: "c" },
    { name: "Supabase", slug: "supabase" },
    { name: "PostgreSQL", slug: "postgresql" },
    { name: "Git", slug: "git" },
    { name: "TailwindCSS", slug: "tailwindcss" },
    { name: "TypeScript", slug: "typescript" },
    { name: "MySQL", slug: "mysql" },
];

const doubleMarquee = [...marqueeItems, ...marqueeItems];

const levelConfig = {
    Expert: {
        color: "text-accent",
        label: "Expert",
        dot: "bg-accent",
        border: "border-accent/30",
    },
    Proficient: {
        color: "text-text-primary",
        label: "Advanced",
        dot: "bg-text-secondary",
        border: "border-border",
    },
    Learning: {
        color: "text-text-muted",
        label: "Learning",
        dot: "bg-text-muted",
        border: "border-border/50",
    },
};
---

<section
    id="skills"
    class="py-24 border-t border-border bg-bg/50 relative overflow-hidden"
>
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-accent/5 blur-[120px] rounded-full pointer-events-none"
    >
    </div>

    <div class="container mb-16">
        <div class="section-header fade-up">
            <p
                class="section-label font-mono text-[0.7rem] tracking-[0.2em] uppercase text-accent mb-3 flex items-center gap-2 before:content-['//'] before:opacity-50"
            >
                <span data-i18n-en>Stack</span>
                <span data-i18n-it style="display:none">Competenze</span>
            </p>
            <h2
                class="section-title font-display text-[clamp(2.5rem,5vw,4rem)] font-extrabold text-text-primary"
            >
                <span data-i18n-en>Skills Matrix</span>
                <span data-i18n-it style="display:none">Matrice Competenze</span
                >
            </h2>
        </div>
    </div>

    <!-- Auto-scrolling Marquee -->
    <div
        class="w-full py-10 bg-surface/20 border-y border-border/50 backdrop-blur-sm relative mb-24 group"
    >
        <div class="flex overflow-hidden select-none gap-12 mask-fade">
            <div
                class="flex items-center gap-16 animate-marquee group-hover:pause"
            >
                {
                    doubleMarquee.map((item) => (
                        <div class="flex items-center justify-center w-20 h-20 rounded-2xl hover:border-accent/50 transition-all hover:scale-110 group/item">
                            <img
                                src={`https://cdn.simpleicons.org/${item.slug}/e8edf2`}
                                alt={item.name}
                                title={item.name}
                                class="w-10 h-10 opacity-60 group-hover/item:opacity-100 transition-opacity grayscale group-hover/item:grayscale-0"
                                loading="lazy"
                            />
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    <!-- Proficiency Matrix Grid -->
    <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20">
            {
                skills.map((category) => (
                    <div class="space-y-8 fade-up">
                        <div class="flex items-center gap-4">
                            <h3 class="font-display text-2xl font-bold text-text-primary tracking-tight">
                                {category.category}
                            </h3>
                            <div class="h-[1px] flex-1 bg-border/50" />
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            {category.items.map((item) => {
                                const conf =
                                    levelConfig[
                                        item.level as keyof typeof levelConfig
                                    ];
                                return (
                                    <div
                                        class={`p-4 rounded-xl border bg-surface/30 backdrop-blur-sm transition-all hover:translate-x-1 group ${conf.border}`}
                                    >
                                        <div class="flex items-center justify-between mb-2">
                                            <span
                                                class={`font-mono text-sm font-bold tracking-wide ${conf.color}`}
                                            >
                                                {item.name}
                                            </span>
                                            <span
                                                class={`w-1.5 h-1.5 rounded-full ${conf.dot} ${item.level === "Expert" ? "animate-pulse shadow-[0_0_8px_var(--color-accent)]" : ""}`}
                                            />
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-[0.6rem] uppercase tracking-widest text-text-muted font-bold">
                                                {conf.label}
                                            </span>
                                            <div class="flex gap-1">
                                                {[1, 2, 3].map((i) => (
                                                    <div
                                                        class={`w-6 h-1 rounded-full ${
                                                            item.level ===
                                                            "Expert"
                                                                ? i <= 3
                                                                    ? "bg-accent"
                                                                    : "bg-border"
                                                                : item.level ===
                                                                    "Proficient"
                                                                  ? i <= 2
                                                                      ? "bg-text-secondary"
                                                                      : "bg-border"
                                                                  : i <= 1
                                                                    ? "bg-text-muted"
                                                                    : "bg-border"
                                                        }`}
                                                    />
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .mask-fade {
        mask-image: linear-gradient(
            to right,
            transparent,
            black 15%,
            black 85%,
            transparent
        );
    }

    .animate-marquee {
        animation: marquee 30s linear infinite;
    }

    @keyframes marquee {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }

    .pause {
        animation-play-state: paused;
    }
</style>
