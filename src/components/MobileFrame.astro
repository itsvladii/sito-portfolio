---
interface Props {
    background?: string;
}

const { background = "var(--color-surface-2)" } = Astro.props;
---

<div class="mobile-frame-container group/mobile">
    <div class="mobile-frame">
        <!-- Camera Hole-punch (Android style) -->
        <div class="camera-hole"></div>

        <!-- Power & Volume Buttons (Typical Android layout on the right) -->
        <div class="button power"></div>
        <div class="button volume-up"></div>
        <div class="button volume-down"></div>

        <!-- Screen Content -->
        <div class="mobile-screen" style={`background: ${background}`}>
            <slot />

            <!-- Gesture Bar -->
            <div class="gesture-bar"></div>

            <!-- Screen Shine -->
            <div class="screen-shine"></div>
        </div>
    </div>
</div>

<style>
    .mobile-frame-container {
        width: 100%;
        max-width: 280px;
        margin: 0 auto;
        perspective: 1000px;
    }

    .mobile-frame {
        position: relative;
        width: 100%;
        aspect-ratio: 9 / 19.5;
        background: #0f0f0f;
        border-radius: 36px;
        padding: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow:
            0 30px 60px -12px rgba(0, 0, 0, 0.5),
            inset 0 0 2px 1px rgba(255, 255, 255, 0.1);
        transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    /* Physical Buttons */
    .button {
        position: absolute;
        background: #1a1a1a;
        border-radius: 2px;
    }

    .power {
        width: 3px;
        height: 45px;
        right: -3px;
        top: 160px;
        border-radius: 0 2px 2px 0;
    }

    .volume-up {
        width: 3px;
        height: 40px;
        right: -3px;
        top: 80px;
        border-radius: 0 2px 2px 0;
    }

    .volume-down {
        width: 3px;
        height: 40px;
        right: -3px;
        top: 122px;
        border-radius: 0 2px 2px 0;
    }

    .camera-hole {
        position: absolute;
        top: 16px;
        left: 50%;
        transform: translateX(-50%);
        width: 12px;
        height: 12px;
        background: #000;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        z-index: 30;
    }

    .mobile-screen {
        position: relative;
        width: 100%;
        height: 100%;
        background: #000;
        border-radius: 28px;
        overflow: hidden;
        z-index: 10;
    }

    .gesture-bar {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 3px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 2px;
        z-index: 20;
    }

    .screen-shine {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            115deg,
            rgba(255, 255, 255, 0.05) 0%,
            transparent 50%
        );
        pointer-events: none;
        z-index: 20;
    }

    @media (max-width: 768px) {
        .mobile-frame-container {
            max-width: 220px;
        }
    }
</style>
