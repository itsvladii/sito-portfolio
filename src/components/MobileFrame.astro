---
interface Props {
  background?: string;
}

const { background = "var(--color-surface-2)" } = Astro.props;
---

<div class="mobile-frame-container group/mobile">
  <div class="mobile-frame">
    <!-- Notch/Dynamic Island -->
    <div class="notch"></div>

    <!-- Power & Volume Buttons -->
    <div class="button power"></div>
    <div class="button volume-up"></div>
    <div class="button volume-down"></div>

    <!-- Screen Content -->
    <div class="mobile-screen" style={`background: ${background}`}>
      <slot />

      <!-- Home Indicator -->
      <div class="home-indicator"></div>

      <!-- Screen Shine -->
      <div class="screen-shine"></div>
    </div>
  </div>
</div>

<style>
  .mobile-frame-container {
    width: 100%;
    max-width: 280px;
    margin: 0 auto;
    perspective: 1000px;
  }

  .mobile-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 19;
    background: #0f0f0f;
    border-radius: 42px;
    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 30px 60px -12px rgba(0, 0, 0, 0.5),
      inset 0 0 2px 1px rgba(255, 255, 255, 0.1);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Physical Buttons */
  .button {
    position: absolute;
    background: #1a1a1a;
    border-radius: 2px;
  }

  .power {
    width: 3px;
    height: 60px;
    right: -3px;
    top: 140px;
    border-radius: 0 2px 2px 0;
  }

  .volume-up {
    width: 3px;
    height: 40px;
    left: -3px;
    top: 100px;
    border-radius: 2px 0 0 2px;
  }

  .volume-down {
    width: 3px;
    height: 40px;
    left: -3px;
    top: 155px;
    border-radius: 2px 0 0 2px;
  }

  .notch {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 24px;
    background: #000;
    border-radius: 12px;
    z-index: 30;
  }

  .mobile-screen {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
    border-radius: 32px;
    overflow: hidden;
    z-index: 10;
  }

  .home-indicator {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
    z-index: 20;
  }

  .screen-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.05) 0%,
      transparent 50%
    );
    pointer-events: none;
    z-index: 20;
  }

  /* Hover Effects */
  :global(.project-band:hover) .mobile-frame {
    transform: rotateY(-10deg) rotateX(5deg) translateY(-10px);
    box-shadow: 20px 40px 80px -20px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 768px) {
    .mobile-frame-container {
        max-width: 220px;
    }
  }
</style>
