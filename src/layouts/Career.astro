---
const timeline = [
    {
        year: "2023 — Present",
        title: {
            en: "BSc Computer & Automation Engineering",
            it: "Laurea Triennale in Ingegneria Informatica e dell'Automazione"
        },
        location: "UNIVPM — Ancona, Italy",
        type: "education",
        branch: "main",
        dotColor: "#00d4ff",
        hash: "a3f9c21"
    },
    {
        year: "07/2023 — 09/2023",
        title: {
            en: "Software Developer (Internship)",
            it: "Sviluppatore Software (Stage)"
        },
        location: "Loccioni Group — Moie, Italy",
        type: "work",
        branch: "feature",
        dotColor: "#D9FD0D",
        hash: "d7b12e4"
    },
    {
        year: "06/2022 — 07/2022",
        title: {
            en: "Erasmus+ Experience",
            it: "Esperienza Erasmus+"
        },
        location: "Barcelona, Spain",
        type: "experience",
        branch: "feature",
        dotColor: "#a855f7",
        hash: "9c3a77f"
    },
    {
        year: "2017 — 2023",
        title: {
            en: "Diploma — Information & Communication Technologies",
            it: "Diploma — Informatica e Telecomunicazioni"
        },
        location: "IIS Marconi Pieralisi — Jesi, Italy",
        type: "education",
        branch: "main",
        dotColor: "#4b5563",
        hash: "1e84b03"
    }
];
---

<section id="career" class="py-24 relative overflow-hidden">
    <div class="container">
        <div class="section-header mb-16 fade-up">
            <p class="section-label font-mono text-[0.7rem] tracking-[0.2em] uppercase text-accent mb-3 flex items-center gap-2 before:content-['//'] before:opacity-50">
                <span data-i18n-en>Journey</span>
                <span data-i18n-it style="display:none">Percorso</span>
            </p>
            <h2 class="section-title font-display text-[clamp(2.5rem,5vw,4rem)] font-extrabold text-text-primary leading-none">
                <span data-i18n-en>Career Log</span>
                <span data-i18n-it style="display:none">Log Carriera</span>
            </h2>
        </div>

        <div class="relative w-full mt-10 md:mt-20 font-mono">
            <div class="relative overflow-x-hidden overflow-y-visible">
                <!-- Desktop View -->
                <div class="hidden md:flex relative w-full h-[650px] items-center">

                    <!-- SVG Git Lines -->
                    <div class="absolute inset-0 pointer-events-none">
                        <svg width="100%" height="100%" viewBox="0 0 1000 650" preserveAspectRatio="none" class="fill-none">
                            <!-- Main Branch -->
                            <path d="M 0 325 L 1000 325" stroke="#00d4ff" stroke-width="2" stroke-dasharray="6 6" opacity="0.1" />
                            <path d="M 0 325 L 1000 325" stroke="#00d4ff" stroke-width="2" stroke-linecap="round" opacity="0.3" />

                            <!-- Erasmus Branch -->
                            <path d="M 125 325 L 250 175 L 500 175 L 625 325" stroke="#a855f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5" />

                            <!-- Internship Branch -->
                            <path d="M 375 325 L 500 475 L 750 475 L 875 325" stroke="#D9FD0D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5" />
                        </svg>
                    </div>

                    <div class="w-full flex justify-around items-center relative z-10">
                        {[...timeline].reverse().map((item, index) => {
                            let yTranslate = '0px';
                            if (item.type === 'experience') yTranslate = '-140px';
                            else if (item.type === 'work') yTranslate = '140px';

                            const isTopCard = item.type === 'work' || (item.branch === 'main' && index === 0);

                            return (
                                <div class="relative flex flex-col items-center group flex-1" style={`transform: translateY(${yTranslate})`}>
                                    <!-- Card -->
                                    <div class={`absolute w-[200px] lg:w-[280px] transition-all duration-500 group-hover:scale-[1.02] ${isTopCard ? 'top-16' : 'bottom-16'}`}>
                                        <div class="p-4 bg-surface/40 border border-border rounded-2xl hover:bg-surface-2 hover:border-border-hover transition-all shadow-2xl backdrop-blur-sm">
                                            <div class="flex items-center justify-between mb-2">
                                                <span class="text-accent font-bold text-[0.6rem] tracking-wider font-mono">commit {item.hash}</span>
                                                <span class={`px-1.5 py-0.5 rounded text-[0.45rem] font-bold uppercase ${item.branch === 'main' ? 'bg-accent/10 text-accent border border-accent/20' : 'bg-surface/50 text-text-muted border border-border'}`}>
                                                    {item.branch === 'main' ? 'main' : `feat/${item.type}`}
                                                </span>
                                            </div>
                                            <div class="space-y-2">
                                                <div class="flex flex-col text-[0.5rem] text-text-muted uppercase tracking-widest leading-relaxed">
                                                    <span>Author: Barcan Vladut</span>
                                                    <span>Date: {item.year}</span>
                                                </div>
                                                <div class="pl-2 border-l-2 border-border">
                                                    <h3 class="text-[0.75rem] font-bold text-text-primary leading-tight font-display">
                                                        <span data-i18n-en>{item.title.en}</span>
                                                        <span data-i18n-it style="display:none">{item.title.it}</span>
                                                    </h3>
                                                    <p class="text-[0.6rem] text-text-muted mt-1.5 flex items-center gap-1.5 font-mono truncate">
                                                        {item.location}
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Node -->
                                    <div class="w-5 h-5 rounded-full border-[4px] border-bg bg-white z-20 shadow-[0_0_20px_rgba(255,255,255,0.05)] transition-all duration-300 group-hover:scale-125 group-hover:shadow-[0_0_25px_currentColor]"
                                         style={`border-color: ${item.dotColor}; color: ${item.dotColor}`}>
                                        <div class="absolute inset-0 rounded-full animate-ping opacity-10 bg-current"></div>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                </div>

                <!-- Mobile View (Vertical) -->
                <div class="md:hidden relative pl-8 space-y-12">
                    <div class="absolute left-[15px] top-0 bottom-0 w-[2px] bg-border/30"></div>
                    {timeline.map((item) => (
                        <div class="relative fade-up">
                            <div class={`absolute -left-[25px] top-4 w-4 h-4 rounded-full border-2 border-bg ${item.dotColor === '#00d4ff' ? 'bg-[#00d4ff]' : item.dotColor === '#D9FD0D' ? 'bg-[#D9FD0D]' : item.dotColor === '#a855f7' ? 'bg-[#a855f7]' : 'bg-text-muted'} z-10`}></div>
                            <div class="p-5 bg-surface/40 border border-border rounded-2xl shadow-xl backdrop-blur-sm">
                                <span class="font-mono text-[0.6rem] text-accent tracking-widest uppercase mb-1 block">{item.year}</span>
                                <h3 class="text-sm font-bold text-text-primary mb-1">
                                    <span data-i18n-en>{item.title.en}</span>
                                    <span data-i18n-it style="display:none">{item.title.it}</span>
                                </h3>
                                <p class="text-[0.65rem] text-text-muted font-mono">{item.location}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>    </div>
</section>

<style>
    #career {
        scroll-margin-top: 100px;
    }
    .custom-scrollbar::-webkit-scrollbar { height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.02); }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }
</style>
