---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
const { title = "Vladi — Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-bg">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta
            name="description"
            content="Portfolio di Vladi — sviluppatore web e mobile."
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();

            if (theme === "light") {
                document.documentElement.setAttribute("data-theme", "light");
                document.documentElement.classList.remove("dark");
            } else {
                document.documentElement.setAttribute("data-theme", "dark");
                document.documentElement.classList.add("dark");
            }
        </script>
    </head>
    <body
        class="font-mono bg-bg text-text-primary overflow-x-hidden min-h-screen"
    >
        <nav
            class="nav fixed top-0 left-0 right-0 z-50 transition-all duration-200 border-b border-transparent"
        >
            <div
                class="max-w-[1100px] mx-auto px-4 md:px-8 h-[60px] flex items-center justify-between"
            >
                <a
                    href="/"
                    class="font-mono text-[0.9rem] md:text-[1rem] font-bold tracking-tighter text-text-primary hover:text-accent transition-colors shrink-0"
                >
                    <span class="text-accent">[</span>vladi<span
                        class="text-text-muted">.</span
                    >dev<span class="text-accent">]</span>
                </a>
                <div class="flex items-center gap-4 md:gap-8">
                    <a
                        href="#career"
                        class="hidden sm:block font-mono text-[0.8rem] tracking-widest text-text-secondary hover:text-text-primary transition-colors"
                        data-i18n="nav.career">Career</a
                    >
                    <a
                        href="#skills"
                        class="hidden sm:block font-mono text-[0.8rem] tracking-widest text-text-secondary hover:text-text-primary transition-colors"
                        data-i18n="nav.skills">Skills</a
                    >
                    <a
                        href="#projects"
                        class="font-mono text-[0.8rem] tracking-widest text-text-secondary hover:text-text-primary transition-colors"
                        data-i18n="nav.projects">Projects</a
                    >
                    <a
                        href="#contact"
                        class="font-mono text-[0.8rem] tracking-widest text-text-secondary hover:text-text-primary transition-colors"
                        data-i18n="nav.contact">Contact</a
                    >
                    <div class="flex items-center gap-2">
                        <ThemeToggle />
                        <button
                            class="font-mono text-[0.7rem] font-bold tracking-[0.15em] text-accent bg-accent-dim border border-[rgba(0,212,255,0.25)] px-[0.65rem] py-[0.3rem] rounded-[4px] cursor-pointer hover:bg-[rgba(0,212,255,0.2)] hover:border-accent transition-all"
                            id="langToggle"
                            aria-label="Toggle language"
                        >
                            <span id="langLabel">IT</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <slot />

        <footer class="border-t border-border py-10 relative z-1">
            <div class="container text-center">
                <p class="font-mono text-[0.75rem] text-text-muted">
                    <span class="text-accent">~/vladi</span>
                    <span data-i18n="footer.text">
                        — proudly built with Astro ✦ 2026</span
                    >
                </p>
            </div>
        </footer>

        <script>
            // Language toggle (IT/EN)
            const translations: Record<string, Record<string, string>> = {
                "nav.career": { it: "Carriera", en: "Career" },
                "nav.projects": { it: "Progetti", en: "Projects" },
                "nav.skills": { it: "Skills", en: "Skills" },
                "nav.contact": { it: "Contatti", en: "Contact" },
                "footer.text": {
                    it: " — fatto con Astro ✦ 2026",
                    en: " — proudly built with Astro ✦ 2026",
                },
            };

            let lang: "it" | "en" =
                (localStorage.getItem("lang") as "it" | "en") || "en";

            function applyLang() {
                document.querySelectorAll("[data-i18n]").forEach((el) => {
                    const key = el.getAttribute("data-i18n")! || "";
                    if (translations[key])
                        el.textContent = translations[key][lang];
                });
                document.querySelectorAll("[data-i18n-it]").forEach((el) => {
                    const htmlEl = el as HTMLElement;
                    htmlEl.style.display = lang === "it" ? "" : "none";
                });
                document.querySelectorAll("[data-i18n-en]").forEach((el) => {
                    const htmlEl = el as HTMLElement;
                    htmlEl.style.display = lang === "en" ? "" : "none";
                });
                const label = document.getElementById("langLabel");
                if (label) label.textContent = lang === "en" ? "IT" : "EN";
                localStorage.setItem("lang", lang);
                document.documentElement.lang = lang;
            }

            document
                .getElementById("langToggle")
                ?.addEventListener("click", () => {
                    lang = lang === "en" ? "it" : "en";
                    applyLang();
                });

            applyLang();

            // Navbar scroll effect
            const nav = document.querySelector(".nav") as HTMLElement;
            window.addEventListener("scroll", () => {
                if (window.scrollY > 40) {
                    nav.classList.add(
                        "bg-bg/85",
                        "backdrop-blur-xl",
                        "border-border",
                    );
                    nav.classList.remove("border-transparent");
                } else {
                    nav.classList.remove(
                        "bg-bg/85",
                        "backdrop-blur-xl",
                        "border-border",
                    );
                    nav.classList.add("border-transparent");
                }
            });
        </script>
    </body>
</html>
