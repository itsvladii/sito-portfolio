---

---

<section id="contact" class="py-32 relative overflow-hidden">
    <!-- Decorative background elements -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-accent/5 blur-[120px] rounded-full pointer-events-none"
    >
    </div>

    <div class="container relative z-10">
        <div class="max-w-4xl mx-auto text-center space-y-12">
            <!-- Header -->
            <div class="space-y-4 fade-up">
                <p class="section-label justify-center">
                    <span data-i18n-en>Get in touch</span>
                    <span data-i18n-it style="display:none">Contatti</span>
                </p>
                <h2
                    class="text-[clamp(2.5rem,8vw,5rem)] font-extrabold leading-none tracking-tighter"
                >
                    <span data-i18n-en
                        >Let's build something <span class="text-accent italic"
                            >special</span
                        >.</span
                    >
                    <span data-i18n-it style="display:none"
                        >Costruiamo qualcosa <span class="text-accent italic"
                            >di speciale</span
                        >.</span
                    >
                </h2>
                <p class="text-xl text-text-secondary max-w-2xl mx-auto">
                    <span data-i18n-en
                        >Always open to new projects or opportunities to grow as
                        a developer and to develop your project. Let's chat!</span
                    >
                    <span data-i18n-it style="display:none"
                        >Sempre disponibile per lavorare su nuovi progetti o opportunità per
                        crescere come sviluppatore e per migliorare il tuo
                        progetto. Parliamo!</span
                    >
                </p>
            </div>

            <!-- Main CTA -->
            <div class="flex flex-col sm:flex-row justify-center items-center gap-6 fade-up" style="animation-delay: 0.2s;">
                <a
                    href="mailto:barcanvladi@gmail.com"
                    class="group relative inline-flex items-center gap-4 px-10 py-5 bg-text-primary text-bg rounded-full font-display text-xl font-bold transition-all hover:scale-105 active:scale-95 hover:shadow-[0_0_40px_var(--color-accent-glow)]"
                >
                    <span data-i18n-en>Say Hello</span>
                    <span data-i18n-it style="display:none">Dì Ciao</span>
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform group-hover:translate-x-1"
                        ><path d="m22 2-7 20-4-9-9-4Z"></path><path
                            d="M22 2 11 13"></path></svg
                    >
                </a>
                <a
                    href="/cv.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group relative inline-flex items-center gap-4 px-10 py-5 bg-transparent border-2 border-text-primary text-text-primary hover:bg-text-primary hover:text-bg rounded-full font-display text-xl font-bold transition-all hover:scale-105 active:scale-95 hover:shadow-[0_0_40px_var(--color-accent-glow)]"
                >
                    <span data-i18n-en>View CV</span>
                    <span data-i18n-it style="display:none">Guarda CV</span>
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform group-hover:scale-110"
                        ><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></svg
                    >
                </a>
            </div>

            <!-- Social Links & Sub-info (Bento Style) -->
            <div
                class="pt-20 border-t border-border/50 grid grid-cols-1 md:grid-cols-3 gap-6 text-left fade-up"
                style="animation-delay: 0.4s;"
            >
                <!-- Status Card -->
                <div
                    class="p-8 bg-surface/40 rounded-3xl border border-border space-y-4 hover:bg-surface-2 transition-colors"
                >
                    <p
                        class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-text-muted"
                    >
                        Current Status
                    </p>
                    <div class="flex items-center gap-3">
                        <span class="relative flex h-2 w-2">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex rounded-full h-2 w-2 bg-accent"
                            ></span>
                        </span>
                        <p class="text-text-secondary font-medium">
                            <span data-i18n-en>Available for new projects</span>
                            <span data-i18n-it style="display:none"
                                >Disponibile per nuovi progetti</span
                            >
                        </p>
                    </div>
                </div>

                <!-- Socials Card -->
                <div
                    class="p-8 bg-surface/40 rounded-3xl border border-border space-y-4 hover:bg-surface-2 transition-colors"
                >
                    <p
                        class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-text-muted"
                    >
                        Socials
                    </p>
                    <div class="grid grid-cols-2 gap-y-3">
                        <a
                            href="https://github.com/itsvladii"
                            target="_blank"
                            class="text-text-secondary hover:text-accent transition-colors flex items-center gap-2 group"
                        >
                            <span>GitHub</span>
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                                ><path d="M7 7h10v10"></path><path
                                    d="M7 17 17 7"></path></svg
                            >
                        </a>
                        <a
                            href="https://www.linkedin.com/in/vladut-barcan-141855315"
                            target="_blank"
                            class="text-text-secondary hover:text-accent transition-colors flex items-center gap-2 group"
                        >
                            <span>LinkedIn</span>
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                                ><path d="M7 7h10v10"></path><path
                                    d="M7 17 17 7"></path></svg
                            >
                        </a>
                        <a
                            href="https://instagram.com/its_vladi_"
                            target="_blank"
                            class="text-text-secondary hover:text-accent transition-colors flex items-center gap-2 group"
                        >
                            <span>Instagram</span>
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                                ><path d="M7 7h10v10"></path><path
                                    d="M7 17 17 7"></path></svg
                            >
                        </a>
                        <a
                            href="https://x.com/asheonetrick"
                            target="_blank"
                            class="text-text-secondary hover:text-accent transition-colors flex items-center gap-2 group"
                        >
                            <span>X</span>
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                                ><path d="M7 7h10v10"></path><path
                                    d="M7 17 17 7"></path></svg
                            >
                        </a>
                    </div>
                </div>

                <!-- Location Card -->
                <div
                    class="p-8 bg-surface/40 rounded-3xl border border-border space-y-4 hover:bg-surface-2 transition-colors"
                >
                    <p
                        class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-text-muted"
                    >
                        Location
                    </p>
                    <div class="space-y-1">
                        <p class="text-text-secondary font-medium">
                            Castelbellino, Italy
                        </p>
                        <p
                            class="text-text-muted text-sm font-mono"
                            id="local-time"
                        >
                            --:-- --
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function updateTime() {
        const timeElement = document.getElementById("local-time");
        if (!timeElement) return;

        const options: Intl.DateTimeFormatOptions = {
            timeZone: "Europe/Rome",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: true,
        };

        const itTime = new Intl.DateTimeFormat("en-US", options).format(
            new Date(),
        );
        timeElement.textContent = `${itTime} GMT+2`;
    }

    updateTime();
    setInterval(updateTime, 1000);
</script>

<style>
    #contact {
        scroll-margin-top: 100px;
    }

    /* Custom underline effect for the " Say Hello" button if desired */
    a.group {
        width: fit-content;
    }
</style>
