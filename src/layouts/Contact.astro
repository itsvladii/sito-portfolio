---

---

<section id="contact" class="py-32 relative overflow-hidden">
    <!-- Decorative background elements -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-accent/5 blur-[120px] rounded-full pointer-events-none"
    >
    </div>

    <div class="container relative z-10">
        <div class="max-w-4xl mx-auto text-center space-y-12">
            <!-- Header -->
            <div class="space-y-4 fade-up">
                <p class="section-label justify-center">
                    <span data-i18n-en>Get in touch</span>
                    <span data-i18n-it style="display:none">Contatti</span>
                </p>
                <h2
                    class="text-[clamp(2.5rem,8vw,5rem)] font-extrabold leading-none tracking-tighter"
                >
                    <span data-i18n-en
                        >Let's build something <span class="text-accent italic"
                            >together</span
                        >.</span
                    >
                    <span data-i18n-it style="display:none"
                        >Costruiamo qualcosa <span class="text-accent italic"
                            >insieme</span
                        >.</span
                    >
                </h2>
                <p class="text-xl text-text-secondary max-w-2xl mx-auto">
                    <span data-i18n-en
                        >I'm always open to new projects or opportunities to be
                        part of your visions. Let's chat!</span
                    >
                    <span data-i18n-it style="display:none"
                        >Sono sempre aperto a nuovi progetti o opportunità per
                        far parte della tua visione. Parliamo!</span
                    >
                </p>
            </div>

            <!-- Main CTA -->
            <div class="fade-up" style="animation-delay: 0.2s;">
                <a
                    href="mailto:barcanvladi@gmail.com"
                    class="group relative inline-flex items-center gap-4 px-10 py-5 bg-text-primary text-bg rounded-full font-display text-xl font-bold transition-all hover:scale-105 active:scale-95 hover:shadow-[0_0_40px_rgba(232,237,242,0.3)]"
                >
                    <span data-i18n-en>Say Hello</span>
                    <span data-i18n-it style="display:none">Dì Ciao</span>
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform group-hover:translate-x-1"
                        ><path d="m22 2-7 20-4-9-9-4Z"></path><path
                            d="M22 2 11 13"></path></svg
                    >
                </a>
            </div>

            <!-- Social Links & Sub-info -->
            <div
                class="pt-20 border-t border-border/50 grid grid-cols-1 md:grid-cols-2 gap-12 text-left fade-up"
                style="animation-delay: 0.4s;"
            >
                <div class="space-y-4">
                    <p
                        class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-text-muted"
                    >
                        Socials
                    </p>
                    <div class="flex flex-col gap-2">
                        <a
                            href="https://github.com/itsvladii"
                            target="_blank"
                            class="text-text-secondary hover:text-accent transition-colors flex items-center gap-2 group"
                        >
                            <span>GitHub</span>
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                                ><path d="M7 7h10v10"></path><path
                                    d="M7 17 17 7"></path></svg
                            >
                        </a>
                        <a
                            href="https:/www.linkedin.com/in/vladut-barcan-141855315"
                            target="_blank"
                            class="text-text-secondary hover:text-accent transition-colors flex items-center gap-2 group"
                        >
                            <span>LinkedIn</span>
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                                ><path d="M7 7h10v10"></path><path
                                    d="M7 17 17 7"></path></svg
                            >
                        </a>
                        <a
                            href="https://instagram.com/its_vladi_"
                            target="_blank"
                            class="text-text-secondary hover:text-accent transition-colors flex items-center gap-2 group"
                        >
                            <span>Instagram</span>
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                                ><path d="M7 7h10v10"></path><path
                                    d="M7 17 17 7"></path></svg
                            >
                        </a>
                        <a
                            href="https://x.com/asheonetrick"
                            target="_blank"
                            class="text-text-secondary hover:text-accent transition-colors flex items-center gap-2 group"
                        >
                            <span>X</span>
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                                ><path d="M7 7h10v10"></path><path
                                    d="M7 17 17 7"></path></svg
                            >
                        </a>
                    </div>
                </div>

                <div class="space-y-4">
                    <p
                        class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-text-muted"
                    >
                        Location
                    </p>
                    <p class="text-text-secondary">
                        Castelbellino, Italy<br /><span class="text-text-muted"
                            >Available worldwide</span
                        >
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    #contact {
        scroll-margin-top: 100px;
    }

    /* Custom underline effect for the " Say Hello" button if desired */
    a.group {
        width: fit-content;
    }
</style>
