---

---

<section
    class="hero min-h-svh flex items-center relative overflow-hidden pt-[60px]"
    id="hero"
>
    <!-- Glow orbs -->
    <div
        class="orb orb-1 absolute rounded-full blur-[80px] pointer-events-none w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(0,212,255,0.08),transparent_70%)] -top-[100px] -left-[100px] animate-pulse-glow"
        aria-hidden="true"
    >
    </div>
    <div
        class="orb orb-2 absolute rounded-full blur-[80px] pointer-events-none w-[400px] h-[400px] bg-[radial-gradient(circle,rgba(124,58,237,0.07),transparent_70%)] bottom-0 -right-[50px] animate-pulse-glow"
        style="animation-direction: reverse;"
        aria-hidden="true"
    >
    </div>

    <div class="container grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="hero-content">
            <div
                class="hero-eyebrow inline-flex items-center gap-2 text-[0.72rem] tracking-[0.12em] text-text-secondary uppercase mb-6 fade-up"
            >
                <span
                    class="dot w-[6px] h-[6px] rounded-full bg-fuelly-primary shadow-[0_0_8px_var(--color-fuelly-primary)] animate-pulse-glow"
                ></span>
                <span data-i18n-en>Available for projects</span>
                <span data-i18n-it style="display:none"
                    >Disponibile per progetti</span
                >
            </div>

            <h1
                class="hero-name font-display text-[clamp(3.5rem,7vw,5.5rem)] font-extrabold leading-[0.95] mb-3 tracking-tighter fade-up"
            >
                <span
                    class="name-line bg-linear-to-br from-text-primary via-text-primary to-accent bg-clip-text text-transparent"
                    >Barcan Vladut</span
                >
            </h1>

            <p
                class="hero-title font-mono text-[clamp(0.9rem,2vw,1.1rem)] text-accent tracking-widest uppercase mb-6 fade-up"
            >
                <span class="title-line" data-i18n-en
                    >Web &amp; Mobile Developer</span
                >
                <span class="title-line" data-i18n-it style="display:none"
                    >Sviluppatore Web &amp; Mobile</span
                >
            </p>

            <p
                class="hero-bio text-[0.9rem] text-text-secondary leading-[1.8] max-w-[480px] mb-10 fade-up"
            >
                <span data-i18n-en
                    >Student, developer, esports nerd. Crafting UIs, backends
                    and mobile apps, while sucking at Overwatch.</span
                >
                <span data-i18n-it style="display:none"
                    >Studente, sviluppatore, appassionato di esports. Costruisco
                    interfacce, backend e app mobile, mentre faccio pena ad
                    Overwatch.</span
                >
            </p>

            <div class="hero-cta flex gap-4 flex-wrap fade-up">
                <a
                    href="#projects"
                    class="btn-primary inline-flex items-center gap-2 px-6 py-3 bg-accent text-bg font-mono text-[0.8rem] font-bold tracking-wider rounded-custom transition-all hover:bg-[#33ddff] hover:-translate-y-[2px] hover:shadow-[0_8px_24px_var(--color-accent-glow)]"
                >
                    <span data-i18n-en>View Projects</span>
                    <span data-i18n-it style="display:none">Vedi Progetti</span>
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        ><path d="M5 12h14M12 5l7 7-7 7"></path></svg
                    >
                </a>
                <a
                    href="#contact"
                    class="btn-secondary inline-flex items-center px-6 py-3 bg-transparent text-text-secondary font-mono text-[0.8rem] tracking-wider border border-border rounded-custom transition-all hover:border-border-hover hover:text-text-primary hover:bg-surface"
                >
                    <span data-i18n-en>Get in touch</span>
                    <span data-i18n-it style="display:none">Contattami</span>
                </a>
            </div>
        </div>

        <!-- Bento Grid -->
        <div
            class="hero-bento grid grid-cols-2 grid-rows-3 gap-4 h-[500px] fade-up"
        >
            <!-- Status Card (Wide) -->
            <div
                class="col-span-2 bg-surface/40 backdrop-blur-md border border-border rounded-custom-lg p-6 flex flex-col justify-between group overflow-hidden relative"
            >
                <div
                    class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"
                >
                    <svg
                        width="60"
                        height="60"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1"
                        ><path
                            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                        ></path></svg
                    >
                </div>
                <div class="flex justify-between items-start">
                    <span
                        class="font-mono text-[0.65rem] text-accent tracking-[0.2em] uppercase font-bold"
                        >Current Status</span
                    >
                    <div class="flex gap-1.5 items-center">
                        <span
                            id="discord-dot"
                            class="w-2 h-2 rounded-full bg-text-muted transition-colors duration-500"
                        ></span>
                        <span
                            id="discord-status-text"
                            class="font-mono text-[0.6rem] text-text-muted font-bold uppercase transition-colors duration-500"
                            >Loading...</span
                        >
                    </div>
                </div>
                <div class="space-y-1">
                    <p
                        id="discord-activity-main"
                        class="text-xl font-display font-bold text-text-primary"
                    >
                        Always building
                    </p>
                    <p
                        id="discord-activity-sub"
                        class="text-[0.8rem] text-text-secondary truncate"
                    >
                        Focusing on high-end web apps.
                    </p>
                </div>
            </div>

            <!-- Location Card -->
            <div
                class="bg-surface/40 backdrop-blur-md border border-border rounded-custom-lg p-6 flex flex-col justify-between relative group overflow-hidden"
            >
                <div
                    class="absolute inset-0 opacity-5 group-hover:opacity-10 transition-opacity"
                >
                    <svg
                        width="100%"
                        height="100%"
                        viewBox="0 0 100 100"
                        preserveAspectRatio="none"
                        ><path
                            d="M0 50 Q 25 25, 50 50 T 100 50"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="0.5"></path></svg
                    >
                </div>
                <span
                    class="font-mono text-[0.65rem] text-text-muted tracking-[0.2em] uppercase font-bold"
                    >Location</span
                >
                <div class="space-y-1">
                    <p class="text-xl font-display font-bold text-text-primary">
                        Castelbellino, Italy
                    </p>
                    <p class="text-[0.7rem] text-accent font-mono">
                        43.29° N, 13.9° E
                    </p>
                </div>
            </div>

            <!-- Music Player Card -->
            <a
                id="music-link"
                href="#"
                target="_blank"
                rel="noopener"
                class="bg-surface/40 backdrop-blur-md border border-border rounded-custom-lg p-6 flex flex-col justify-between relative group overflow-hidden transition-all hover:bg-surface/60"
            >
                <div
                    class="absolute -right-2 -top-2 opacity-5 group-hover:opacity-10 transition-opacity rotate-12"
                >
                    <svg
                        width="120"
                        height="120"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="0.5"
                        ><circle cx="12" cy="12" r="10"></circle><circle
                            cx="12"
                            cy="12"
                            r="3"></circle></svg
                    >
                </div>
                <div class="flex justify-between items-start">
                    <span
                        id="music-status-label"
                        class="font-mono text-[0.65rem] text-text-muted tracking-[0.2em] uppercase font-bold"
                        >Listening</span
                    >
                    <div id="music-bars" class="flex gap-[2px] items-end h-3">
                        {
                            [0.6, 1, 0.4, 0.8].map((h) => (
                                <div
                                    class="music-bar w-1 bg-accent animate-[music-bar_1s_ease-in-out_infinite]"
                                    style={`height: ${h * 100}%; animation-delay: ${h}s`}
                                />
                            ))
                        }
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div
                        class="w-12 h-12 rounded-lg bg-surface-2 border border-border flex items-center justify-center relative overflow-hidden group-hover:scale-105 transition-transform"
                    >
                        <img
                            id="track-image"
                            src=""
                            class="absolute inset-0 w-full h-full object-cover opacity-40 hidden"
                        />
                        <div
                            id="track-placeholder"
                            class="absolute inset-0 bg-linear-to-br from-accent/20 to-purple-500/20 flex items-center justify-center"
                        >
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                class="text-accent"
                                ><path d="M9 18V5l12-2v13"></path><circle
                                    cx="6"
                                    cy="18"
                                    r="3"></circle><circle cx="18" cy="16" r="3"
                                ></circle></svg
                            >
                        </div>
                    </div>
                    <div class="space-y-0.5 overflow-hidden">
                        <p
                            id="track-title"
                            class="text-sm font-bold text-text-primary truncate"
                        >
                            Nothing playing
                        </p>
                        <p
                            id="track-artist"
                            class="text-[0.7rem] text-text-muted truncate"
                        >
                            Apple Music
                        </p>
                    </div>
                </div>
            </a>

            <!-- Stats Card (Wide) -->
            <!-- Social & Connect Card (Wide) -->
            <div
                class="col-span-2 bg-surface/20 border border-border/50 rounded-custom-lg p-4 flex flex-col md:flex-row items-center gap-4 group"
            >
                <div class="flex-1 flex items-center gap-4 w-full">
                    <a
                        href="https://github.com/itsvladii"
                        target="_blank"
                        rel="noopener"
                        class="flex-1 flex items-center justify-center gap-3 py-3 bg-surface/40 border border-border rounded-xl hover:border-accent/50 hover:bg-surface/60 transition-all group/social"
                    >
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="text-text-muted group-hover/social:text-text-primary transition-colors"
                            ><path
                                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
                            ></path></svg
                        >
                        <span
                            class="font-mono text-xs font-bold text-text-secondary group-hover/social:text-text-primary uppercase tracking-wider"
                            >GitHub</span
                        >
                    </a>
                    <a
                        href="https:/www.linkedin.com/in/vladut-barcan-141855315"
                        target="_blank"
                        rel="noopener"
                        class="flex-1 flex items-center justify-center gap-3 py-3 bg-surface/40 border border-border rounded-xl hover:border-accent/50 hover:bg-surface/60 transition-all group/social"
                    >
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="text-text-muted group-hover/social:text-[#0077b5] transition-colors"
                            ><path
                                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                            ></path></svg
                        >
                        <span
                            class="font-mono text-xs font-bold text-text-secondary group-hover/social:text-text-primary uppercase tracking-wider"
                            >LinkedIn</span
                        >
                    </a>
                </div>
                <button
                    id="copy-email"
                    class="w-full md:w-auto flex-[1.2] flex items-center justify-between px-5 py-3 bg-accent/10 border border-accent/20 rounded-xl hover:border-accent/50 hover:bg-accent/20 transition-all group/email cursor-pointer relative overflow-hidden"
                >
                    <div class="flex items-center gap-3">
                        <div
                            class="p-2 bg-accent/20 rounded-lg text-accent group-hover/email:scale-110 transition-transform"
                        >
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                                ></path><polyline points="22,6 12,13 2,6"
                                ></polyline></svg
                            >
                        </div>
                        <div class="text-left">
                            <p
                                id="email-label"
                                class="font-mono text-[0.6rem] text-accent font-bold uppercase tracking-widest"
                            >
                                Get in touch
                            </p>
                            <p
                                id="email-text"
                                class="text-xs font-bold text-text-primary"
                            >
                                barcanvladut@gmail.com
                            </p>
                        </div>
                    </div>
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="text-text-muted group-hover/email:text-accent group-hover/email:translate-x-1 transition-all"
                        ><path d="M5 12h14M12 5l7 7-7 7"></path></svg
                    >
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    // Discord Integration
    const DISCORD_ID = import.meta.env.PUBLIC_DISCORD_ID;

    async function updateDiscord() {
        if (!DISCORD_ID) return;
        try {
            const res = await fetch(
                `https://api.lanyard.rest/v1/users/${DISCORD_ID}`,
            );
            const { data } = await res.json();

            const dot = document.getElementById("discord-dot");
            const statusText = document.getElementById("discord-status-text");
            const mainAct = document.getElementById("discord-activity-main");
            const subAct = document.getElementById("discord-activity-sub");

            if (!data || !dot || !statusText || !mainAct || !subAct) return;

            const statusColors: Record<string, string> = {
                online: "bg-fuelly-primary",
                dnd: "bg-red-500",
                idle: "bg-yellow-500",
                offline: "bg-text-muted",
            };

            dot.className = `w-2 h-2 rounded-full transition-colors duration-500 ${statusColors[data.discord_status] || "bg-text-muted"}`;
            if (data.discord_status !== "offline")
                dot.classList.add(
                    "animate-pulse",
                    "shadow-[0_0_8px_currentColor]",
                );

            statusText.textContent = data.discord_status;
            statusText.className = `font-mono text-[0.6rem] font-bold uppercase transition-colors duration-500 ${data.discord_status === "offline" ? "text-text-muted" : "text-text-primary"}`;

            const activity =
                data.activities.find((a: any) => a.type === 0) ||
                data.activities[0];

            if (activity) {
                mainAct.textContent = activity.name;
                subAct.textContent =
                    activity.details || activity.state || "Active now";
            } else {
                mainAct.textContent =
                    data.discord_status === "offline"
                        ? "Currently Offline"
                        : "Idling";
                subAct.textContent =
                    data.discord_status === "offline"
                        ? "Back soon."
                        : "Taking a break.";
            }
        } catch (e) {
            console.error("Discord update failed", e);
        }
    }

    setInterval(updateDiscord, 15000);
    updateDiscord();

    async function updateMusic() {
        try {
            const res = await fetch("/api/now-playing.json");
            const data = await res.json();

            const titleEl = document.getElementById("track-title");
            const artistEl = document.getElementById("track-artist");
            const imageEl = document.getElementById(
                "track-image",
            ) as HTMLImageElement;
            const placeholderEl = document.getElementById("track-placeholder");
            const linkEl = document.getElementById(
                "music-link",
            ) as HTMLAnchorElement;
            const statusLabel = document.getElementById("music-status-label");
            const bars = document.querySelectorAll(".music-bar");

            if (data && !data.error && titleEl && artistEl) {
                titleEl.textContent = data.title;
                artistEl.textContent = `${data.artist} — Apple Music`;

                if (data.image && imageEl && placeholderEl) {
                    imageEl.src = data.image;
                    imageEl.classList.remove("hidden");
                    placeholderEl.classList.add("hidden");
                } else if (imageEl && placeholderEl) {
                    imageEl.classList.add("hidden");
                    placeholderEl.classList.remove("hidden");
                }

                if (linkEl) linkEl.href = data.url;

                if (data.isPlaying) {
                    statusLabel!.textContent = "Now Playing";
                    bars.forEach(
                        (bar) =>
                            ((bar as HTMLElement).style.animationPlayState =
                                "running"),
                    );
                } else {
                    statusLabel!.textContent = "Last Played";
                    bars.forEach(
                        (bar) =>
                            ((bar as HTMLElement).style.animationPlayState =
                                "paused"),
                    );
                }
            } else if (data && data.error) {
                console.warn("Last.fm API Error:", data.error);
                if (titleEl) titleEl.textContent = "Offline";
                if (artistEl) artistEl.textContent = "Apple Music";
                if (bars)
                    bars.forEach(
                        (bar) =>
                            ((bar as HTMLElement).style.animationPlayState =
                                "paused"),
                    );
            }
        } catch (e) {
            console.error("Music update failed", e);
        }
    }

    setInterval(updateMusic, 30000);
    updateMusic();

    // Copy Email Logic
    const copyBtn = document.getElementById("copy-email");
    const emailText = "barcanvladut@gmail.com";
    const emailLabel = document.getElementById("email-label");

    copyBtn?.addEventListener("click", () => {
        navigator.clipboard.writeText(emailText);
        if (emailLabel) {
            const originalText = emailLabel.textContent;
            emailLabel.textContent = "Copied!";
            emailLabel.classList.add("text-green-500");
            setTimeout(() => {
                emailLabel.textContent = originalText;
                emailLabel.classList.remove("text-green-500");
            }, 2000);
        }
    });
</script>
